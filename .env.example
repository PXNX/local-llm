# Copy to .env (not in git) and fill in your own values.
# Telegram (9-top5-videos.bat): https://my.telegram.org -> API development tools
TELEGRAM_API_ID=1234567
TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef
# Two-step verification (cloud) password of the account, leave empty if not set / to be asked
TELEGRAM_PASSWORD=
# Vision LLM used by all flows (common/llm.py): openrouter (free cloud models) or ollama (local qwen3-vl:4b)
LLM_PROVIDER=openrouter
# https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Any vision-capable model, free ones end in :free - https://openrouter.ai/models?max_price=0
OPENROUTER_MODEL=qwen/qwen3.8-27b:free
# Hugging Face token, only needed to download gated models (FLUX.2 klein) - https://huggingface.co/settings/tokens
HF_TOKEN=
# Up to 3 fallback models (comma separated), tried when the model above fails or is rate limited
OPENROUTER_FALLBACKS=google/gemma-4-31b-it:free,dots-studio/dots-3-note-preview:free,nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
# One folder for every model (ComfyUI, Ollama, Hugging Face, torch, rembg, Kokoro), empty = models\ in this folder
MODELS_DIR=
# 1 = use the local Ollama model (OLLAMA_MODEL, default qwen3-vl:4b) when every OpenRouter model fails
LLM_LOCAL_FALLBACK=1
