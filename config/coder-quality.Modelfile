# local-coder:quality - the GUI's Coding page builds it from LLM_CODING_QUALITY_MODEL; 3-coding-llm-t3code.bat
# quality uses this file when it is missing. Shares the weights of the model in FROM: nothing is downloaded.
FROM qwen3.8-blend:27b
PARAMETER num_ctx 32768
PARAMETER temperature 0.6
PARAMETER top_p 0.95
PARAMETER top_k 20
PARAMETER min_p 0
