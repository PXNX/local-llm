# local-coder:speed - the GUI's Coding page builds it from LLM_CODING_SPEED_MODEL; 3-coding-llm-t3code.bat speed
# uses this file when it is missing. Shares the weights of the model in FROM: nothing is downloaded or copied.
FROM qwen3:8b
PARAMETER num_ctx 16384
PARAMETER temperature 0.7
PARAMETER top_p 0.8
PARAMETER top_k 20
PARAMETER min_p 0
