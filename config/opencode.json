{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/deepseek-v4.1-flash-free",
  "small_model": "opencode/mimo-v2.6-flash-free",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen3:8b": {
          "name": "Qwen3 8B (small, fits in VRAM)",
          "limit": {
            "context": 32768,
            "output": 8192
          }
        },
        "gpt-oss:20b": {
          "name": "gpt-oss 20B (medium, partly CPU)",
          "limit": {
            "context": 32768,
            "output": 8192
          }
        },
        "qwen3-coder:30b": {
          "name": "Qwen3-Coder 30B-A3B (large, mostly CPU)",
          "limit": {
            "context": 32768,
            "output": 8192
          }
        },
        "qwen3.8-blend:27b": {
          "name": "JetBrains Qwen3.8/3.6 27B blend IQ3_S (large, dense, slow)",
          "limit": {
            "context": 32768,
            "output": 8192
          }
        },
        "local-coder:speed": {
          "name": "Local coder - speed (qwen3:8b, no thinking)",
          "limit": {
            "context": 16384,
            "output": 8192
          },
          "options": {
            "reasoningEffort": "none"
          }
        },
        "local-coder:quality": {
          "name": "Local coder - quality (qwen3.8-blend:27b, thinking)",
          "limit": {
            "context": 32768,
            "output": 8192
          }
        },
        "local-coder:long": {
          "name": "Local coder - 200k (qwen3.8-blend:27b, thinking)",
          "limit": {
            "context": 204800,
            "output": 8192
          }
        }
      }
    },
    "openrouter": {
      "options": {
        "apiKey": "{env:OPENROUTER_API_KEY}"
      },
      "models": {
        "cohere/north-mini-code:free": {
          "name": "Cohere North Mini Code (free, OpenRouter)",
          "limit": {
            "context": 256000,
            "output": 16384
          }
        },
        "poolside/laguna-s-2.1:free": {
          "name": "Poolside Laguna S 2.1 (free, OpenRouter)",
          "limit": {
            "context": 262144,
            "output": 16384
          }
        }
      }
    },
    "llama-cpp": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama.cpp (local)",
      "options": {
        "baseURL": "http://127.0.0.1:8080/v1"
      },
      "models": {
        "nvidia/NVIDIA-Nemotron-3.5-Bolt-E4B-4GB:Q4_K_M": {
          "name": "Nemotron 3.5 Bolt E4B 4GB",
          "limit": {
            "context": 57344,
            "output": 8192
          }
        },
        "byteshape/Qwen3.6-35B-A3B-GGUF:Q4_K_S": {
          "name": "Qwen3.6-35B-A3B (MoE, 64k, fastest local)",
          "limit": {
            "context": 65536,
            "output": 16384
          }
        },
        "saidutta69/Qwen3-8B-heretic:Q4_K_M": {
          "name": "Qwen3-8B heretic (abliterated, 32k, slow)",
          "limit": {
            "context": 32768,
            "output": 8192
          }
        },
        "empero-ai/Qwen3.8-35B-A3B-Distill-GGUF:Q3_K_M": {
          "name": "Qwen3.8-35B-A3B Distill (MoE, 64k, newer, ~1/3 slower)",
          "limit": {
            "context": 65536,
            "output": 16384
          }
        }
      }
    }
  }
}
